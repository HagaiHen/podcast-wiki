{
  "name": "podcast-wiki",
  "displayName": "Podcast Wiki",
  "version": "0.1.1",
  "description": "Turn the podcasts you listen to on Spotify into a Karpathy-style LLM wiki: one page per topic, synthesized across episodes, every claim cited.",
  "author": { "name": "Hagai Hen", "url": "https://github.com/HagaiHen" },
  "homepage": "https://hagaihen.github.io/podcast-wiki/",
  "repository": "https://github.com/HagaiHen/podcast-wiki",
  "license": "MIT",
  "keywords": ["llm-wiki", "podcasts", "spotify", "obsidian", "second-brain", "knowledge-base"],
  "skills": ["./.claude/skills/", "./plugin/"],
  "commands": ["./.claude/commands/ingest-podcasts.md"],
  "mcpServers": {
    "spotify": {
      "command": "uv",
      "args": ["run", "--frozen", "--project", "${CLAUDE_PROJECT_DIR}", "${CLAUDE_PROJECT_DIR}/tools/spotify_mcp.py"]
    }
  }
}
